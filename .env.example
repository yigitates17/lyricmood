# Copy to .env (same folder) and fill in. Never commit .env.
# Each key is optional until the milestone that needs it; `uv run lyricmood status` shows what's set.

# --- Spotify (milestone 1) ---------------------------------------------------
# From https://developer.spotify.com/dashboard -> your app -> Settings.
# PKCE login: no client secret needed.
SPOTIFY_CLIENT_ID=
# Must match a Redirect URI registered in the dashboard exactly.
# Spotify rejects "localhost"; use the loopback IP.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Last.fm (milestone 2) ---------------------------------------------------
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# --- Optional ----------------------------------------------------------------
# Where the SQLite cache, vectors and the Spotify token live (default ~/.lyricmood).
# LYRICMOOD_DATA_DIR=~/.lyricmood
# Max Spotify requests per second (dev-mode quota is shared across your apps).
# LYRICMOOD_SPOTIFY_RPS=5
