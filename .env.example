# Copy to .env (same folder) and fill in. Never commit .env.
# Each key is optional until the milestone that needs it; `uv run lyricmood status` shows what's set.

# --- Spotify (milestone 1) ---------------------------------------------------
# From https://developer.spotify.com/dashboard -> your app -> Settings.
# PKCE login: no client secret needed.
SPOTIFY_CLIENT_ID=
# Must match a Redirect URI registered in the dashboard exactly.
# Spotify rejects "localhost"; use the loopback IP.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Last.fm (milestone 2, recommended) ---------------------------------------
# https://www.last.fm/api/account/create -> copy the "API key" (not the secret).
# Without it: no tags, and get_artist_tracks uses Spotify search order.
LASTFM_API_KEY=

# LRCLIB and ReccoBeats need no key.

# --- Optional ----------------------------------------------------------------
# Where the SQLite cache, vectors and the Spotify token live (default ~/.lyricmood).
# LYRICMOOD_DATA_DIR=~/.lyricmood
# Max Spotify requests per second (dev-mode quota is shared across your apps).
# LYRICMOOD_SPOTIFY_RPS=5
# LYRICMOOD_LASTFM_RPS=4
# LYRICMOOD_LRCLIB_RPS=2
# LYRICMOOD_RECCOBEATS_RPS=2
# Lyrics sent to the LLM are cut at a stanza boundary below this many characters.
# LYRICMOOD_LYRICS_MAX_CHARS=2500
# Per-song lyrics sample size in analyze_artists.
# LYRICMOOD_EXCERPT_MAX_CHARS=500
# Candidates gathered by find_similar_by_lyrics before ranking (each new one
# costs ~1 Spotify search + 1-2 LRCLIB calls once, then it's cached).
# LYRICMOOD_SIMILAR_POOL_SIZE=40
# Candidates build_mood_playlist considers (seed + similar artists, or your
# top + liked songs).
# LYRICMOOD_MOOD_POOL_SIZE=60
